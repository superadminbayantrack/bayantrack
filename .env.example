# Frontend build variable. Leave blank when using the Cloudflare /api proxy.
VITE_API_BASE_URL=

# Cloudflare Pages Function proxy target for /api/*.
# Example: API_ORIGIN=https://api.your-domain.com
API_ORIGIN=

# Node/Express backend variables. Set these on the backend host.
# Vercel's MongoDB Atlas integration commonly creates MONGODB_URI.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/bayantrack?retryWrites=true&w=majority&appName=BayanTrack
# Optional override when the URI does not include a database name.
MONGODB_DB_NAME=bayantrack
# Legacy local name still supported by the app:
MONGO_URI=
# Required. Use at least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL=7d
CORS_ORIGIN=https://bayan-track.pages.dev,https://your-domain.com
PING_MESSAGE=ping

# Mail settings for OTP and notifications.
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional production bootstrap accounts. Change defaults before going live.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_CONTACT=
BOOTSTRAP_SUPERADMIN_USERNAME=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_CONTACT=

# Emergency-only local fallback. Keep false in production.
ALLOW_EMBEDDED_ACCOUNTS=false
EMBEDDED_ADMIN_PASSWORD=
EMBEDDED_SUPERADMIN_PASSWORD=
